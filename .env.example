# ── 발송 채널 ───────────────────────────────────────────────
# DISCORD_WEBHOOK_URL 이 설정되면 Discord 웹훅으로 발송, 없으면 텔레그램으로 발송.
DISCORD_WEBHOOK_URL=

# 텔레그램 봇 (발송용) — DISCORD_WEBHOOK_URL 미설정 시 사용
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── 텔레그램 유저 계정 (수집용, Telethon) ───────────────────
TELEGRAM_API_ID=0
TELEGRAM_API_HASH=
TELEGRAM_PHONE=
SESSION_NAME=earnings_screener
TELEGRAM_FOLDER_ID=0

# ── 데이터 소스 API ─────────────────────────────────────────
FINNHUB_API_KEY=
OPENDART_API_KEY=
EDGAR_USER_AGENT=EarningsScreener admin@example.com

# ── 스크리닝/실행 파라미터 ──────────────────────────────────
SCHEDULE_HOURS=7,19
LOOKBACK_DAYS=3
LOW_52W_THRESHOLD=0.05
LOG_LEVEL=INFO
